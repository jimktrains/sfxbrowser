class RepeatTimer(threading.Thread):
    def __init__(self, event, isstopped):
        super().__init__()
        self.stopped = event
        self.isstopped = isstopped
        self.scrub_line = None

    def run(self):
        while not self.stopped.wait(1/60):
            (length, rate, maxv, minv, encoding, channels, fileFormat, headerSize) = mysound.info()
            length_s = length / rate
            elapsed = tkSnack.audio.elapsedTime()
            if elapsed > 0:
                if self.scrub_line is not None:
                    c.delete(self.scrub_line)
                if elapsed < length_s:
                    x = int(500 / length_s * elapsed)
                    print(f"{x=}")
                    self.scrub_line = c.create_line(x, 0, x, 350, width=2)
        isstopped.set()

stopsched = threading.Event()
isstopped = threading.Event()
thread = RepeatTimer(stopsched, isstopped)
thread.start()

def quitall(e):
    stopsched.set()
    isstopped.wait()
    parent.destroy()

